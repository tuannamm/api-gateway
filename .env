# Copy thành .env để chạy local: cp .env.example .env
# Gateway tự nạp .env khi khởi động (process.loadEnvFile); biến môi trường thật luôn thắng.
# Danh sách đầy đủ: README.md mục "Biến môi trường".

# Tên THƯ MỤC project trong specs/ (specs/<project>/openapi.yml), không phải tên file.
GATEWAY_PROJECT=identity
GATEWAY_REGISTRY_URL=http://localhost:8500

# Xác minh JWT do Keycloak cấp (realm pm). Bắt buộc khi spec có route cần đăng nhập.
# ISSUER phải trùng claim `iss` trong token; AUDIENCE phải trùng `aud` (do audience mapper của client pm-web).
KEYCLOAK_ISSUER=http://localhost:8081/realms/pm
KEYCLOAK_AUDIENCE=w-identity

# Origin của frontend (u-project-management) được gọi từ trình duyệt.
GATEWAY_CORS_ORIGINS=http://localhost:3001
